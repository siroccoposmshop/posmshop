# Supabase — from the NEW Sirocco-owned Supabase project (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Publishable key (sb_publishable_...) — or the legacy "anon" key as NEXT_PUBLIC_SUPABASE_ANON_KEY
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) — server only, never expose. Legacy "service_role" key also works as SUPABASE_SERVICE_ROLE_KEY
SUPABASE_SECRET_KEY=

# Public URL of the site (used in emails)
NEXT_PUBLIC_SITE_URL=https://posmshop.vercel.app

# Resend — transactional email (https://resend.com). Verify the sirocco.ae domain there.
RESEND_API_KEY=
EMAIL_FROM="POSM SHOP <posm@sirocco.ae>"

# Salesforce (org mmielr) — outlet list sync. Leave blank until IT has set up the integration user.
SALESFORCE_DOMAIN=https://mmielr.my.salesforce.com
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
# Optional: override field API names if a label ever changes, e.g. {"kam":"Sirocco_KAM__c"}
SALESFORCE_FIELDS=
# Any long random string; the nightly sync route requires it (Vercel sends it automatically).
CRON_SECRET=

# Commerce Hub project emails. Until projects@sirocco.ae is verified in Resend, leave blank (uses EMAIL_FROM).
PROJECTS_EMAIL_FROM="Commerce Hub <projects@sirocco.ae>"
