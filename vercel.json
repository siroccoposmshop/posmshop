{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "crons": [
    {
      "path": "/api/cron/salesforce-sync",
      "schedule": "0 23 * * *"
    },
    {
      "path": "/api/cron/project-digest",
      "schedule": "0 5 * * 1"
    }
  ]
}
